# 大鹅 Dashboard（已集成 dae）
# 使用上游 feeds，软件包、地理数据及所需内核模块由依赖自动选择。
CONFIG_PACKAGE_luci-app-daed=y

# BTF 需显式启用，并要求完整调试信息。
# 当前支持的设备与上游默认启用 CGROUPS / CGROUP_BPF；
# BPF_EVENTS、BPF_STREAM_PARSER 和 XDP_SOCKETS 随 BTF 默认启用。
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
