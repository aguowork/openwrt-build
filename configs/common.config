# 仅叠加所需插件与自定义项目依赖，其余沿用上游默认值。

# 构建缓存与发布元数据，不改变运行时设置。
# 上游仅在 DEVEL 下允许选择 CCACHE。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

# LuCI 与简体中文。
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# 用户指定的 LuCI 插件。
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 用户指定的命令。
CONFIG_PACKAGE_coreutils-shuf=y
CONFIG_PACKAGE_coreutils-base64=y

# files/ 中脚本、网页和 CGI 使用的运行依赖。
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# Kong 的 AdGuardHome 等 Lua 插件所需兼容库。
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
