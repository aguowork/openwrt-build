# 公共插件与编译配置文件，所有设备共用。
# 定义通用插件、依赖及编译选项，设备专属配置请放在对应的设备配置文件中。

# 编译选项
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

# BusyBox 配置
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y

# 网络协议
CONFIG_PACKAGE_proto-bonding=y
CONFIG_PACKAGE_luci-proto-relay=y

# 共享库
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_libopenssl-legacy=y

# 禁用软件包
CONFIG_PACKAGE_automount=n
# CONFIG_PACKAGE_coremark is not set
# 不预装 iStoreX / iStore / QuickStart 和 Lucky
# CONFIG_PACKAGE_luci-app-istorex is not set
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-app-quickstart is not set
# CONFIG_PACKAGE_quickstart is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_lucky is not set

# 不预装 Docker、管理界面及容器运行时
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-lib-docker is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set

# 不预装额外 DNS、策略路由和组网服务
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_smartdns-ui is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_geo2txt is not set
# CONFIG_PACKAGE_luci-app-pbr is not set
# CONFIG_PACKAGE_pbr is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_easytier is not set
# CONFIG_EASYTIER_INCLUDE_WEBCONSOLE is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_kmod-wireguard is not set

# 默认设置
# 可选插件由 Actions 勾选项对应的片段开启。
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-daed is not set
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# iptables-nft 防火墙兼容
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# 软件包
# 通用命令行工具
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-shuf=y

# 启用 LuCI 应用
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Local_Disk_Information_Detection=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-wol=y
