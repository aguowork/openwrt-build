# Redmi AX6 startup defaults.

# 每周三 09:00 自动重启。
uci set autoreboot.cfg016bf2.enabled='1'
uci set autoreboot.cfg016bf2.week='3'
uci set autoreboot.cfg016bf2.hour='9'
uci commit autoreboot

# 防火墙区域：LAN 使用 lan，WAN 使用 wan、wan6 和 wwan。
uci del firewall.cfg02dc81.network
uci add_list firewall.cfg02dc81.network='lan'
uci del firewall.cfg03dc81.network
uci add_list firewall.cfg03dc81.network='wan'
uci add_list firewall.cfg03dc81.network='wan6'
uci add_list firewall.cfg03dc81.network='wwan'
uci commit firewall

# 创建通过 DHCP 获取地址的 wwan 接口。
uci set network.wwan=interface
uci set network.wwan.proto='dhcp'
uci commit network

# 2.4G（radio1）：AX 模式、40MHz 带宽及热点设置。
uci set wireless.radio1.htmode='HE40'
uci set wireless.default_radio1.ssid='H'
uci set wireless.default_radio1.key='88888888..'
uci set wireless.default_radio1.encryption='psk2'

# 5G（radio0）：固定非 DFS 主信道，AX 模式、80MHz 带宽及热点设置。
# 不固定信道时首启生成的配置是 channel='auto'，hostapd 会走 ACS 选信道：
# ath11k 上 ACS 既可能选到 DFS 信道（52~64 / 100~144）而卡在 CAC 期间不广播 SSID，
# 也可能因为同一 radio 上还有 STA 在扫描而直接启动失败，表现为 5G 热点"没起来"。
# 36 属于 5150~5250 非 DFS 频段，也是 HE80（36~48）的主信道。
#
# 注意：中继 STA（wifinet2）也挂在 radio0 上，一块射频同一时刻只能待在一个信道，
# 因此 AP 与 STA 必须同信道。这里钉 36 的前提是上级 b1403 的 5G 也固定到 36~48，
# 否则 STA 会连不上（现象：5G 热点能搜到，但中继不通、没有外网）。
# 若 b1403 的 5G 落在 149 一类信道上，二选一：
#   1) 登录上级路由把 b1403 的 5G 信道改成 36/40/44/48；
#   2) 把 wifinet2.device 改成 'radio1'，改用 2.4G 回传、radio0 专职 5G 热点。
uci set wireless.radio0.channel='36'
uci set wireless.radio0.htmode='HE80'
uci set wireless.default_radio0.ssid='H'
uci set wireless.default_radio0.key='88888888..'
uci set wireless.default_radio0.encryption='psk2'

# 无线中继：通过 radio0 连接上级热点，接入 wwan 接口。
# 加密方式必须与上级热点一致，否则认证阶段就失败（表现为反复 deauth、
# 拿不到 IP，日志里是 authentication/association timeout）：
#   上级 WPA2-PSK  -> 'psk2'      （b1403 实测为 WPA2，故此处用 psk2）
#   上级 WPA3-SAE  -> 'sae'
#   上级 WPA2/WPA3 混合 -> 'sae-mixed'
# 用 `iwinfo <sta-if> scan | grep -A12 'ESSID: "b1403"'` 的 Encryption 字段确认。
uci set wireless.wifinet2=wifi-iface
uci set wireless.wifinet2.device='radio0'
uci set wireless.wifinet2.mode='sta'
uci set wireless.wifinet2.network='wwan'
uci set wireless.wifinet2.ssid='b1403'
uci set wireless.wifinet2.encryption='psk2'
uci set wireless.wifinet2.key='13539012490'

# 统一保存无线配置。
uci commit wireless

# 设置设备显示名称。
uci set wechatpush.config.device_name='Redmi-AX6'
uci commit wechatpush
